<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="clinicmanagerPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.clinicmanager.model.User</class>
        <class>com.clinicmanager.model.Patient</class>
        <class>com.clinicmanager.model.Doctor</class>
        <class>com.clinicmanager.model.Department</class>
        <class>com.clinicmanager.model.Specialty</class>
        <class>com.clinicmanager.model.Availability</class>
        <class>com.clinicmanager.model.Appointment</class>
        <class>com.clinicmanager.model.MedicalNote</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5433/dbClinic"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="clinicuser"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="mouawya1234"/>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
